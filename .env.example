# ── Personal monitor (scripts/monitor.mjs) ────────────────────────────────────

# Webhook URL for reset alerts — supports Discord, Slack, Telegram, or generic.
# Leave empty to disable webhook notifications.
CODEX_WEBHOOK_URL=

# For Telegram: also set the chat ID (obtained via @userinfobot or the API).
CODEX_TELEGRAM_CHAT_ID=

# Override which Codex plan you're on (affects alert messages).
# Values: Free | Plus | Pro | Team | Enterprise | Unknown
CODEX_PLAN=Plus

# Override the Codex CLI config directory (default: ~/.codex).
# CODEX_HOME=

# Override where the monitor stores its last-seen state between polls.
# CODEX_MONITOR_STATE=


# ── Autonomous collector (scripts/collect.mjs — GitHub Actions) ───────────────

# X API v2 Bearer Token — enables Twitter/X as a collection source.
# Create a free app at https://developer.twitter.com to get one.
# Set this as a GitHub Actions secret, not in a local .env file.
TWITTER_BEARER_TOKEN=


# ── GitHub Actions only (set automatically, do not configure manually) ────────

# ISSUE_BODY      — body of the GitHub issue being processed
# ISSUE_NUMBER    — issue number
# ISSUE_URL       — URL of the issue
# GITHUB_OUTPUT   — path to the Actions step output file
