{
  "name": "codex-reset-tracker",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "monitor": "node scripts/monitor.mjs",
    "monitor:raw": "node scripts/monitor.mjs --raw",
    "monitor:fixture": "node scripts/monitor.mjs --fixture scripts/fixtures/usage-weekly-low.json",
    "backup:db": "bash scripts/backup-db.sh",
    "backup:verify": "bash scripts/verify-db-restore.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0"
  }
}
